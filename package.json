{
  "name": "nakshatra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage && npm run coverage:check:features",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage && npm run coverage:check:features",
    "coverage:check:features": "node scripts/check-feature-coverage.mjs",
    "test:db:start": "supabase start -x edge-runtime,imgproxy,logflare,studio,vector",
    "test:db:reset": "supabase db reset --local",
    "test:db": "supabase test db supabase/tests/database --local",
    "test:db:local": "npm run db:verify",
    "db:smoke": "node scripts/check-db-fixtures.mjs",
    "db:verify": "node scripts/verify-local-db.mjs",
    "ci:db:start": "node scripts/start-supabase-ci.mjs",
    "ci:db:diagnose": "node scripts/diagnose-supabase-ci.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit:coverage && npm run test:db:local && npm run build && npm run test:e2e",
    "test:watch": "vitest",
    "security:audit": "npm audit --audit-level=high",
    "privacy:process-deletions": "node scripts/process-account-deletions.mjs",
    "identity-verification:process": "node scripts/process-identity-verifications.mjs",
    "broker-introductions:process": "node scripts/process-broker-introductions.mjs",
    "demo:broker-pilot:reset": "supabase db reset --local --sql-paths ./seeds/broker-pilot-demo.sql",
    "privacy:retention": "node scripts/run-data-retention.mjs",
    "pilot:admin": "node scripts/manage-pilot-administrator.mjs",
    "pilot:creator": "node scripts/manage-pilot-creator.mjs",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.generated.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shaders": "^2.5.133",
    "sharp": "0.35.4",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "supabase": "^2.115.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
