# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DELETION_REAUTH_COOKIE_SECRET=replace-with-a-unique-server-only-32-plus-character-secret
BROKERDESK_REAUTH_COOKIE_SECRET=replace-with-a-different-server-only-32-plus-character-secret
BROKERDESK_INVITATION_TOKEN_SECRET=replace-with-an-independent-server-only-32-plus-character-secret
RATE_LIMIT_SUBJECT_HMAC_KEY=replace-with-a-unique-server-only-32-plus-character-secret
IDENTITY_VERIFICATION_MATCH_HMAC_KEY=replace-with-an-independent-server-and-worker-32-plus-character-secret
# Set only when production traffic reaches the app exclusively through Cloudflare.
# Vercel deployments are detected through VERCEL=1; local development uses X-Forwarded-For.
NAKSHATRA_TRUSTED_PROXY=
DIDIT_APPLICATION_ID=replace-with-your-didit-application-uuid
DIDIT_ENVIRONMENT=sandbox
DIDIT_WORKFLOW_ID=replace-with-your-approved-didit-workflow-uuid

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application notifications only; optional until Resend delivery is activated.
# Server-only: never prefix these with NEXT_PUBLIC_. Auth SMTP is configured separately.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
