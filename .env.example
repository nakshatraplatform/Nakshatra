# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
# Optional future enhancement. ZIP/PIN lookup works without Google.
GOOGLE_PLACES_API_KEY=
DELETION_REAUTH_COOKIE_SECRET=replace-with-a-unique-server-only-32-plus-character-secret
BROKERDESK_REAUTH_COOKIE_SECRET=replace-with-a-different-server-only-32-plus-character-secret
BROKERDESK_INVITATION_TOKEN_SECRET=replace-with-an-independent-server-only-32-plus-character-secret
RATE_LIMIT_SUBJECT_HMAC_KEY=replace-with-a-unique-server-only-32-plus-character-secret
IDENTITY_VERIFICATION_MATCH_HMAC_KEY=replace-with-an-independent-server-and-worker-32-plus-character-secret
# Set only when production traffic reaches the app exclusively through Cloudflare.
# Vercel deployments are detected through VERCEL=1; local development uses X-Forwarded-For.
NAKSHATRA_TRUSTED_PROXY=
# Didit: use matching credentials and workflow from the intended Sandbox/Live app.
# Set secret values only in local/server secret storage; never use NEXT_PUBLIC_.
DIDIT_API_KEY=
# Candidate workflow: liveness only, no Face Match, IP analysis, or ID module.
# Shared with representative session creation; do not enable both policies on this workflow.
DIDIT_WORKFLOW_ID=replace-with-your-liveness-only-workflow-uuid
# Didit returns workflow_version per session; no version environment variable is required.
DIDIT_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry — optional public DSN; missing/invalid DSN disables SDK delivery.
NEXT_PUBLIC_SENTRY_DSN=
# development, preview, production or test; Vercel env is detected at build time.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional release override; Vercel commit SHA is detected automatically.
SENTRY_RELEASE=
SENTRY_ORG=vivintro
SENTRY_PROJECT=nakshatra
# Build-only private token for source-map upload. NEVER use NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# Public founder/operator and privacy-contact details.
# Operator can be the responsible individuals; do not invent a registered entity.
# Address/governing-law fields are optional and shown only when supplied.
# REGISTERED_ADDRESS is the existing key for an approved public business/contact address.
VIVINTRO_FOUNDER_NAME=
VIVINTRO_FOUNDER_URL=
VIVINTRO_LEGAL_ENTITY_NAME="Nagarjun Mallesh and Rahul Gollapalli Rangnatha"
VIVINTRO_REGISTERED_ADDRESS=
VIVINTRO_GOVERNING_LAW=
VIVINTRO_GRIEVANCE_CONTACT="Nagarjun Mallesh and Rahul Gollapalli Rangnatha"
VIVINTRO_GRIEVANCE_EMAIL=nakshathra.platform@gmail.com

# Application notifications only; optional until Resend delivery is activated.
# Server-only: never prefix these with NEXT_PUBLIC_. Auth SMTP is configured separately.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
# Protects POST /api/internal/relationship-notifications. Configure the same
# 32+ character value in the external scheduler that invokes the worker.
NOTIFICATION_WORKER_SECRET=replace-with-an-independent-server-only-32-plus-character-secret
# Delivery operations: independent stable HMAC key shared by app and Node workers.
# Rotating it without migrating suppression hashes bypasses previous suppressions.
EMAIL_RECIPIENT_HMAC_KEY=
# Signing secret for the Resend application delivery webhook, not an API key.
RESEND_WEBHOOK_SECRET=
# Local application-delivery alert budgets; provider account usage is authoritative.
RESEND_DAILY_EMAIL_LIMIT=100
RESEND_MONTHLY_EMAIL_LIMIT=3000

# Optional fixed marketing button counters. Leave off until custom-event plan
# availability and the corresponding privacy notice are reviewed. No account,
# signup-completion, introduction URL or personal values are sent.
NEXT_PUBLIC_MARKETING_EVENTS_ENABLED=false
