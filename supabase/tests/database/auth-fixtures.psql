-- Test-only helpers loaded by individual pgTAP files with \ir. This file lives
-- beside the test suites so the Supabase pg_prove container can read it. Its
-- non-.sql suffix prevents the runner from treating it as an executable test.
--
-- Fixture rows are created while the pgTAP runner still has its trusted role.
-- Runtime assertions must then switch to the role being exercised. Never use
-- service_role to inspect app_private state: reset role returns to the runner.

create or replace function pg_temp.create_auth_actor(
  p_user_id uuid,
  p_session_id uuid,
  p_email text,
  p_session_created_at timestamptz default now()
)
returns void
language plpgsql
as $$
begin
  if p_user_id is null or p_session_id is null then
    raise exception 'test actor requires user and session identifiers' using errcode = '22023';
  end if;

  insert into auth.users (
    id, aud, role, email, email_confirmed_at, created_at, updated_at
  ) values (
    p_user_id, 'authenticated', 'authenticated', p_email, now(), now(), now()
  );

  insert into auth.sessions (id, user_id, created_at, updated_at)
  values (p_session_id, p_user_id, p_session_created_at, now());
end;
$$;

create or replace function pg_temp.create_auth_session(
  p_user_id uuid,
  p_session_id uuid,
  p_session_created_at timestamptz default now()
)
returns void
language plpgsql
as $$
begin
  if not exists (select 1 from auth.users where id = p_user_id) then
    raise exception 'test session user does not exist' using errcode = '22023';
  end if;

  insert into auth.sessions (id, user_id, created_at, updated_at)
  values (p_session_id, p_user_id, p_session_created_at, now());
end;
$$;

-- SECURITY DEFINER is safe here because this temporary function exists only in
-- the pgTAP connection. It prevents a test from accidentally using a JWT whose
-- session is missing or belongs to a different fixture user.
create or replace function pg_temp.set_authenticated_claims(
  p_user_id uuid,
  p_session_id uuid,
  p_aal text default 'aal1'
)
returns void
language plpgsql
security definer
set search_path = pg_catalog, auth
as $$
begin
  if p_aal not in ('aal1', 'aal2') then
    raise exception 'test JWT assurance level is invalid' using errcode = '22023';
  end if;
  if not exists (
    select 1
    from auth.sessions session_record
    where session_record.id = p_session_id
      and session_record.user_id = p_user_id
  ) then
    raise exception 'test JWT session is absent or belongs to another user' using errcode = '22023';
  end if;

  perform set_config(
    'request.jwt.claims',
    jsonb_build_object(
      'sub', p_user_id::text,
      'role', 'authenticated',
      'session_id', p_session_id::text,
      'aal', p_aal
    )::text,
    true
  );
end;
$$;

create or replace function pg_temp.set_anon_claims()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end;
$$;

create or replace function pg_temp.set_service_role_claims()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
end;
$$;

-- Test-only bridge for the server-owned publication command. Callers retain
-- their authenticated fixture identity; only the trusted connection may invoke
-- the service RPC, which then rebinds to the same live Auth session.
create or replace function pg_temp.publish_portfolio_as_owner(
  p_portfolio_id uuid,
  p_draft_data jsonb,
  p_public_data jsonb,
  p_approved_data jsonb,
  p_share_token text,
  p_expires_at timestamptz,
  p_template_id integer,
  p_theme_color text,
  p_sun_sign text
)
returns jsonb
language plpgsql
security definer
set search_path = ''
as $$
declare
  actor_user_id uuid := auth.uid();
  actor_session_id uuid := (auth.jwt() ->> 'session_id')::uuid;
  original_claims text := pg_catalog.current_setting('request.jwt.claims', true);
  publication_result jsonb;
begin
  if auth.role() is distinct from 'authenticated' then
    raise exception 'test publication requires authenticated claims' using errcode = '42501';
  end if;
  perform pg_catalog.set_config('request.jwt.claims', '{"role":"service_role"}', true);
  publication_result := public.service_publish_portfolio_transaction(
    actor_user_id, actor_session_id, p_portfolio_id, p_draft_data,
    p_public_data, p_approved_data, p_share_token, p_expires_at,
    p_template_id, p_theme_color, p_sun_sign
  );
  perform pg_catalog.set_config('request.jwt.claims', coalesce(original_claims, '{}'), true);
  return publication_result;
exception when others then
  perform pg_catalog.set_config('request.jwt.claims', coalesce(original_claims, '{}'), true);
  raise;
end;
$$;

-- Publication-focused migrations intentionally reject legacy minimal fixtures.
-- These helpers keep unrelated perimeter tests explicit about satisfying the
-- current production gates without weakening those gates in application code.
create or replace function pg_temp.complete_portfolio_draft(
  p_draft jsonb default '{}'::jsonb
)
returns jsonb
language sql
immutable
as $$
  select
    (coalesce(p_draft, '{}'::jsonb) - 'personal' - 'career' - 'vitals')
    || pg_catalog.jsonb_build_object(
      'personal',
      '{"first_name":"Test","last_name":"Person","dob":"1990-01-01","gender":"female","country":"United States","city":"Test City","current_location":"Test City, United States","marital_status":"Never Married","short_bio":"A complete test introduction.","profile_for":"self"}'::jsonb
        || coalesce(p_draft -> 'personal', '{}'::jsonb),
      'career',
      '{"title":"Test role"}'::jsonb || coalesce(p_draft -> 'career', '{}'::jsonb),
      'vitals',
      '{"height":"5''5\""}'::jsonb || coalesce(p_draft -> 'vitals', '{}'::jsonb)
    )
$$;

-- Test-only normalized liveness/IP proof for publication fixtures.
create or replace function pg_temp.prime_photo_identity_verification(p_portfolio_id uuid)
returns void language sql security definer set search_path = '' as $$
  update app_private.identity_verification_subjects subject_record
  set current_proof_method='candidate_liveness_ip',
      current_proof_portfolio_id=null,current_proof_media_id=null,current_proof_sha256=null,
      current_liveness_verified=true,current_ip_verified=true,
      current_proof_workflow_id='ffffffff-ffff-4fff-8fff-ffffffffffff',
      current_proof_workflow_version=1,updated_at=pg_catalog.now()
  from public.portfolios portfolio
  where portfolio.id=p_portfolio_id and subject_record.candidate_id=portfolio.candidate_id
    and subject_record.status='verified'
$$;

create or replace function pg_temp.prime_paid_publication(
  p_portfolio_id uuid,
  p_draft jsonb
)
returns void
language sql
security definer
set search_path = ''
as $$
  insert into public.candidate_personal_details(candidate_id, profile_for)
  select portfolio.candidate_id, 'self'
  from public.portfolios portfolio where portfolio.id = p_portfolio_id
  on conflict (candidate_id) do update set profile_for = 'self';

  -- Keep the persisted draft aligned with the draft whose publication
  -- fingerprint is primed below. Pilot eligibility reads the stored draft.
  update public.portfolios set
    draft_data = p_draft,
    published_data = coalesce(published_data, '{}'::jsonb) || pg_catalog.jsonb_build_object(
      'personal', coalesce(published_data -> 'personal', '{}'::jsonb) || '{"profile_for":"self"}'::jsonb
    )
  where id = p_portfolio_id;

  insert into app_private.b2c_creator_entitlements (email_hash)
  select app_private.normalized_email_hash(account.email)
  from public.portfolios portfolio
  join auth.users account on account.id = portfolio.user_id
  where portfolio.id = p_portfolio_id
  on conflict (email_hash) do update set
    revoked_at = null,
    revoked_by = null,
    updated_at = pg_catalog.now();

  insert into app_private.portfolio_publication_progress (
    portfolio_id,
    selected_plan_code,
    plan_selected_at,
    payment_status,
    payment_confirmed_at,
    payment_expires_at,
    disclosure_version,
    disclosure_fingerprint,
    disclosure_confirmed_at
  ) values (
    p_portfolio_id,
    'test_plan',
    pg_catalog.now(),
    'paid',
    pg_catalog.now(),
    pg_catalog.now() + interval '365 days',
    'publication-disclosure-v2',
    app_private.portfolio_draft_fingerprint(p_draft),
    pg_catalog.now()
  )
  on conflict (portfolio_id) do update set
    selected_plan_code = excluded.selected_plan_code,
    plan_selected_at = excluded.plan_selected_at,
    payment_status = excluded.payment_status,
    payment_confirmed_at = excluded.payment_confirmed_at,
    payment_expires_at = excluded.payment_expires_at,
    disclosure_version = excluded.disclosure_version,
    disclosure_fingerprint = excluded.disclosure_fingerprint,
    disclosure_confirmed_at = excluded.disclosure_confirmed_at,
    updated_at = pg_catalog.now();

  select pg_temp.prime_photo_identity_verification(p_portfolio_id)
$$;

-- A saved self-owned draft is required by the current pilot, but its primary
create or replace function pg_temp.set_invalid_session_claims(p_user_id uuid, p_session_id text)
returns void language plpgsql as $$
begin
  if exists(select 1 from auth.sessions where id::text=p_session_id and user_id=p_user_id) then
    raise exception 'negative fixture cannot represent an active owned session';
  end if;
  perform set_config('request.jwt.claims',jsonb_build_object('sub',p_user_id,'role','authenticated','session_id',p_session_id)::text,true);
end;
$$;

-- photo is not a verification input. Use only in verification-specific suites.
create or replace function pg_temp.create_self_verification_draft(p_candidate_id uuid)
returns void language plpgsql as $$
begin
  insert into public.candidate_personal_details(candidate_id,profile_for)
  values(p_candidate_id,'self') on conflict(candidate_id) do update set profile_for='self';
  insert into app_private.b2c_creator_entitlements(email_hash)
  select app_private.normalized_email_hash(account.email) from public.candidates candidate
  join auth.users account on account.id=candidate.primary_owner_user_id
  where candidate.id=p_candidate_id on conflict(email_hash) do nothing;
  insert into public.portfolios(user_id,candidate_id,draft_data)
  select primary_owner_user_id,id,'{"personal":{"profile_for":"self"}}'::jsonb
  from public.candidates where id=p_candidate_id;
end;
$$;
